PY = python3

all: colleen grace sully

colleen:
	@$(PY) Colleen.py

grace:
	@$(PY) Grace.py

sully:
	@$(PY) Sully.py

clean:
	@echo "Nothing to clean (no object files)"

fclean: clean
	@echo "Nothing to fclean (no executables)"

re: fclean all	

run-colleen: colleen
run-grace: grace
run-sully: sully


